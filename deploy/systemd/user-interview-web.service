[Unit]
Description=Realtime Interview web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=interview
Group=interview
WorkingDirectory=/opt/user-interview/apps/web
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
EnvironmentFile=/opt/user-interview/.env
ExecStart=/usr/bin/node /opt/user-interview/apps/web/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
