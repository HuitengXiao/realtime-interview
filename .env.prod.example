# -----------------------------------------------------------------------------
# Core application
# -----------------------------------------------------------------------------
PORT="3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_INTERVIEW_REALTIME_URL="ws://localhost:3001"
INTERVIEW_REALTIME_PORT="3001"
INTERVIEW_ALLOWED_ORIGIN="http://localhost:3000"
REALTIME_AUTH_SECRET=""
INTERVIEW_MAX_SESSION_MINUTES="120"

# Database (canonical contract; do not copy FunASR DATABASE_HOST/PASSWORD aliases)
DATABASE_URL=""
DIRECT_URL=""

# Authentication and organization invitations
BETTER_AUTH_SECRET=""

# Optional OAuth providers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Transactional mail (required for invitations and password recovery)
# -----------------------------------------------------------------------------
MAIL_FROM="Realtime Interview <hello@example.com>"
MAIL_HOST=""
MAIL_PORT="587"
MAIL_USER=""
MAIL_PASS=""

# Optional API mail providers. Configure only the provider used by the code.
PLUNK_API_KEY=""
RESEND_API_KEY=""
POSTMARK_SERVER_TOKEN=""

# -----------------------------------------------------------------------------
# Current public-image storage (avatars and organization logos only)
# Recordings and exports require separate private buckets and authorization.
# -----------------------------------------------------------------------------
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_REGION="auto"
S3_FORCE_PATH_STYLE="true"
NEXT_PUBLIC_AVATARS_BUCKET_NAME="avatars"

# -----------------------------------------------------------------------------
# Cloud-only interview speech, translation, and Agent adapters.
# No FUNASR_MODEL/FUNASR_DEVICE/GPU/local runtime variables belong here.
# -----------------------------------------------------------------------------

# Default cloud LLM compatibility layer, shared when service-specific keys below
# are empty.
OPENAI_BASE_URL=""
OPENAI_API_KEY=""

# Realtime ASR: recommended Aliyun Paraformer provider
DASHSCOPE_API_KEY=""
ALIYUN_ASR_WORKSPACE_ID=""
ALIYUN_ASR_REGION="cn-beijing"
ALIYUN_ASR_ENDPOINT=""
ALIYUN_ASR_MODEL="paraformer-realtime-v2"
ALIYUN_ASR_LANGUAGE_HINTS="zh,en"
ALIYUN_ASR_FORMAT="pcm"
ALIYUN_ASR_SAMPLE_RATE="16000"
ALIYUN_ASR_MAX_SENTENCE_SILENCE="800"
ALIYUN_ASR_SEMANTIC_PUNCTUATION="false"
ALIYUN_ASR_HEARTBEAT="true"
ALIYUN_ASR_CONNECT_TIMEOUT="20"

# Optional OpenAI-compatible, utterance-based ASR fallback
CLOUD_ASR_BASE_URL=""
CLOUD_ASR_API_KEY=""
CLOUD_ASR_MODEL="whisper-1"
ASR_TIMEOUT_SECONDS="60"

# Cloud translation
TRANSLATION_API_KEY=""
TRANSLATION_BASE_URL=""
TRANSLATION_MODEL=""
TRANSLATION_TIMEOUT_SECONDS="45"

# Interview Agent
AGENT_API_KEY=""
AGENT_BASE_URL=""
AGENT_MODEL=""
AGENT_TIMEOUT_SECONDS="45"

# -----------------------------------------------------------------------------
# Optional analytics (all NEXT_PUBLIC values are browser-visible)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PIRSCH_CODE=""
NEXT_PUBLIC_PLAUSIBLE_URL=""
NEXT_PUBLIC_MIXPANEL_TOKEN=""
NEXT_PUBLIC_GOOGLE_TAG_ID=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_UMAMI_TRACKING_ID=""

# -----------------------------------------------------------------------------
# Optional billing; keep empty until organization billing is enabled
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
LEMONSQUEEZY_STORE_ID=""
CHARGEBEE_SITE=""
CHARGEBEE_API_KEY=""
CREEM_API_KEY=""
CREEM_WEBHOOK_SECRET=""
NEXT_PUBLIC_PRODUCT_ID_PRO_MONTHLY=""
NEXT_PUBLIC_PRODUCT_ID_PRO_YEARLY=""

# -----------------------------------------------------------------------------
# Optional legacy importer (not used by the application runtime)
# -----------------------------------------------------------------------------
FUNASR_SOURCE_DATABASE_URL=""
ONEBAND_SOURCE_DATABASE_URL=""
FUNASR_TARGET_ORGANIZATION_ID=""
ONEBAND_DEFAULT_OWNER_EMAIL=""
